@model SecuritySystemsManagerMVC.ViewModels.UserEditVm

@{
    ViewData["Title"] = "Създаване на потребител";
}

<div class="container-fluid px-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-2 text-gray-800">Създаване на потребител</h1>
            <p class="mb-0">Добави нов потребител в системата</p>
        </div>
        <div>
            <a asp-action="List" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-2"></i>Обратно към списъка
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Информация за потребителя</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Username" class="form-label"></label>
                                    <input asp-for="Username" class="form-control" />
                                    <span asp-validation-for="Username" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input asp-for="Email" class="form-control" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="FirstName" class="form-label"></label>
                                    <input asp-for="FirstName" class="form-control" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="LastName" class="form-label"></label>
                                    <input asp-for="LastName" class="form-control" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="RoleId" class="form-label"></label>
                                    <select asp-for="RoleId" class="form-select" asp-items="Model.AvailableRoles">
                                        <option value="">-- Избери роля --</option>
                                    </select>
                                    <span asp-validation-for="RoleId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="ProfileImage" class="form-label">Профилна снимка</label>
                                    <input type="file" name="profileImageFile" class="form-control" accept="image/*" />
                                    <small class="form-text text-muted">Качи профилна снимка (незадължително)</small>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Парола</label>
                                    <input type="password" name="Password" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Потвърди парола</label>
                                    <input type="password" name="ConfirmPassword" class="form-control" required />
                                </div>
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-2"></i>Създай потребител
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Информация</h5>
                </div>
                <div class="card-body">
                    <h6 class="mb-3">Права на ролите</h6>
                    <ul class="list-group mb-4">
                        <li class="list-group-item d-flex align-items-center">
                            <div class="me-3">
                                <i class="bi bi-shield-fill text-primary"></i>
                            </div>
                            <div>
                                <h6 class="mb-0">Admin</h6>
                                <small class="text-muted">Пълен достъп до системата</small>
                            </div>
                        </li>
                        <li class="list-group-item d-flex align-items-center">
                            <div class="me-3">
                                <i class="bi bi-briefcase-fill text-success"></i>
                            </div>
                            <div>
                                <h6 class="mb-0">Manager</h6>
                                <small class="text-muted">Управлява поръчки и техници</small>
                            </div>
                        </li>
                        <li class="list-group-item d-flex align-items-center">
                            <div class="me-3">
                                <i class="bi bi-tools text-warning"></i>
                            </div>
                            <div>
                                <h6 class="mb-0">Technician</h6>
                                <small class="text-muted">Обработва назначени поръчки</small>
                            </div>
                        </li>
                        <li class="list-group-item d-flex align-items-center">
                            <div class="me-3">
                                <i class="bi bi-person-fill text-info"></i>
                            </div>
                            <div>
                                <h6 class="mb-0">Client</h6>
                                <small class="text-muted">Създава и преглежда собствени поръчки</small>
                            </div>
                        </li>
                    </ul>
                    
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        <span>Идентификационните данни на потребителя трябва да бъдат предоставени ръчно след създаването.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 