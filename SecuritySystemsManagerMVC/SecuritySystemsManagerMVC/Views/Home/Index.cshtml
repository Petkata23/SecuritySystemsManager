@{
    ViewData["Title"] = "Начало";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="hero-title">Модерни системи за сигурност за съвременна защита</h1>
                <p class="hero-text">Security Systems Hristovi предлага иновативни решения за сигурност за бизнеси и домове. Нашите интегрирани системи осигуряват пълна защита и спокойствие.</p>
                <div class="hero-buttons">
                    <a href="#services" class="btn btn-primary btn-lg">Разгледай решения</a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="SecuritySystemOrder" asp-action="Create" class="btn btn-outline-secondary btn-lg">Създай поръчка</a>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-secondary btn-lg">Свържи се с нас</a>
                    }
                </div>
                <div class="hero-stats mt-5">
                    <div class="row">
                        <div class="col-4">
                            <div class="stat-item">
                                <div class="stat-number">15+</div>
                                <div class="stat-label">Години опит</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-item">
                                <div class="stat-number">5000+</div>
                                <div class="stat-label">Инсталации</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-item">
                                <div class="stat-number">24/7</div>
                                <div class="stat-label">Поддръжка</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-image-container">
                    <img src="~/img/security-pattern.svg" alt="Security Systems" class="img-fluid hero-image">
                    <div class="hero-shape-1"></div>
                    <div class="hero-shape-2"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section" id="features">
    <div class="container-fluid">
        <div class="section-header text-center">
            <h2>Защо да ни изберете</h2>
            <p>Предлагаме цялостни решения за сигурност с модерна технология и експертен сервиз</p>
        </div>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h3>Модерна технология</h3>
                    <p>Нашите системи използват най-новите технологии за сигурност с аналитика, задвижвана от изкуствен интелект, и интелигентни възможности за откриване.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-phone"></i>
                    </div>
                    <h3>Дистанционно наблюдение</h3>
                    <p>Контролирайте и наблюдавайте вашите системи за сигурност от всяко място чрез нашето мобилно приложение с известия в реално време.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-headset"></i>
                    </div>
                    <h3>Експертна поддръжка</h3>
                    <p>Нашият професионален екип осигурява техническа поддръжка 24/7 и бърза реакция на всички проблеми със сигурността.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Services Section -->
<section class="services-section" id="services">
    <div class="container-fluid">
        <div class="section-header text-center">
            <h2>Нашите решения за сигурност</h2>
            <p>Цялостна защита за жилищни и търговски имоти</p>
        </div>
        <div class="row">
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="service-card">
                    <div class="service-image">
                        <img src="img/cctv.jpg" alt="CCTV Systems" class="img-fluid">
                        <div class="service-overlay">
                            <i class="bi bi-camera-video"></i>
                        </div>
                    </div>
                    <div class="service-content">
                        <h3>Видеонаблюдение</h3>
                        <p>Камери за наблюдение с висока резолюция с напреднали възможности за откриване на движение и нощно виждане.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="service-card">
                    <div class="service-image">
                        <img src="img/alarm_system.jpg" alt="Alarm Systems" class="img-fluid">
                        <div class="service-overlay">
                            <i class="bi bi-bell"></i>
                        </div>
                    </div>
                    <div class="service-content">
                        <h3>Алармни системи</h3>
                        <p>Напреднало откриване на проникване с незабавни известия и интегрирани протоколи за реакция.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="service-card">
                    <div class="service-image">
                        <img src="img/access_control.jpg" alt="Access Control" class="img-fluid">
                        <div class="service-overlay">
                            <i class="bi bi-fingerprint"></i>
                        </div>
                    </div>
                    <div class="service-content">
                        <h3>Контрол на достъпа</h3>
                        <p>Сигурни системи за вход с биометрично удостоверяване и мобилно управление на достъпа.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="service-card">
                    <div class="service-image">
                        <img src="img/fire_detection.webp" alt="Fire Detection" class="img-fluid">
                        <div class="service-overlay">
                            <i class="bi bi-fire"></i>
                        </div>
                    </div>
                    <div class="service-content">
                        <h3>Пожарна сигнализация</h3>
                        <p>Системи за ранно предупреждение с сензори за топлина и дим за цялостна противопожарна защита.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="service-card">
                    <div class="service-image">
                        <img src="img/smart_home.jpg" alt="Smart Home Security" class="img-fluid">
                        <div class="service-overlay">
                            <i class="bi bi-house-door"></i>
                        </div>
                    </div>
                    <div class="service-content">
                        <h3>Умна домашна сигурност</h3>
                        <p>Интегрирани решения с функции за автоматизация за пълна защита и контрол на дома.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="service-card">
                    <div class="service-image">
                        <img src="img/maintenance_services.jpg" alt="Maintenance Services" class="img-fluid">
                        <div class="service-overlay">
                            <i class="bi bi-tools"></i>
                        </div>
                    </div>
                    <div class="service-content">
                        <h3>Услуги за поддръжка</h3>
                        <p>Редовни проверки на системите и превантивна поддръжка за осигуряване на оптимална производителност на сигурността.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Process Section -->
<section class="process-section">
    <div class="container-fluid">
        <div class="section-header text-center">
            <h2>Как работим</h2>
            <p>Нашият оптимизиран процес осигурява безпроблемна реализация на решенията за сигурност</p>
        </div>
        <div class="process-timeline">
            <div class="row">
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="process-step">
                        <div class="process-number">1</div>
                        <div class="process-icon">
                            <i class="bi bi-chat-dots"></i>
                        </div>
                        <h3>Консултация</h3>
                        <p>Оценяваме вашите нужди за сигурност и предоставяме експертни препоръки.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="process-step">
                        <div class="process-number">2</div>
                        <div class="process-icon">
                            <i class="bi bi-clipboard-check"></i>
                        </div>
                        <h3>Проектиране</h3>
                        <p>Нашият екип създава персонализиран дизайн на система за сигурност за вашия имот.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="process-step">
                        <div class="process-number">3</div>
                        <div class="process-icon">
                            <i class="bi bi-gear"></i>
                        </div>
                        <h3>Инсталация</h3>
                        <p>Професионална инсталация от нашите сертифицирани техници.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="process-step">
                        <div class="process-number">4</div>
                        <div class="process-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <h3>Поддръжка</h3>
                        <p>Постоянна поддръжка и техническа помощ 24/7.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials Section -->
<section class="testimonials-section">
    <div class="container-fluid">
        <div class="section-header text-center">
            <h2>Какво казват нашите клиенти</h2>
            <p>Доверени от бизнеси и собственици на домове в цяла България</p>
        </div>
        <div class="row">
            <div class="col-lg-4 mb-4">
                <div class="testimonial-card">
                    <div class="testimonial-content">
                        <p>"Security Systems Hristovi provided an excellent service from consultation to installation. Their team was professional and knowledgeable, and the system works flawlessly."</p>
                    </div>
                    <div class="testimonial-author">
                        <img src="/img/demo-avatars/demo-avatar-man.jpg" alt="Client" class="testimonial-avatar">
                        <div class="testimonial-info">
                            <h4>Ivan Petrov</h4>
                            <p>Собственик на бизнес</p>
                            <div class="testimonial-rating">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 mb-4">
                <div class="testimonial-card">
                    <div class="testimonial-content">
                        <p>"We've been using their services for over 5 years now. Their maintenance team is always prompt and efficient. I highly recommend their 24/7 monitoring service."</p>
                    </div>
                    <div class="testimonial-author">
                        <img src="/img/demo-avatars/demo-avatar-woman.jpg" alt="Client" class="testimonial-avatar">
                        <div class="testimonial-info">
                            <h4>Maria Dimitrova</h4>
                            <p>Собственик на дом</p>
                            <div class="testimonial-rating">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-half"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 mb-4">
                <div class="testimonial-card">
                    <div class="testimonial-content">
                        <p>"The smart home security system they installed has given us peace of mind. The mobile app is user-friendly, and their customer support is exceptional."</p>
                    </div>
                    <div class="testimonial-author">
                        <img src="/img/demo-avatars/demo-avatar-man-2.jpg" alt="Client" class="testimonial-avatar">
                        <div class="testimonial-info">
                            <h4>Stefan Georgiev</h4>
                            <p>Управител на имоти</p>
                            <div class="testimonial-rating">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section">
    <div class="container-fluid">
        <div class="cta-content">
            <h2 class="cta-title">Готови ли сте да подобрите сигурността си?</h2>
            <p class="cta-text">Свържете се с нас днес за безплатна консултация и персонализирана оценка на сигурността.</p>
            <div class="cta-buttons">
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="SecuritySystemOrder" asp-action="Create" class="btn btn-cta-primary">Създай поръчка</a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-cta-primary">Започни</a>
                }
                <a href="#" class="btn btn-cta-secondary">Научи повече</a>
            </div>
        </div>
    </div>
</section>

