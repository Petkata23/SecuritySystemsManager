@model IEnumerable<SecuritySystemsManager.Shared.Dtos.NotificationDto>
@{
    ViewData["Title"] = "Известия";
    var unreadCount = Model.Count(n => !n.IsRead);
}

@section Styles {
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
}

<div class="container notifications-container animate-fade-in py-4">
    @if (Model.Any())
    {
        <!-- Modern Banner -->
        <div class="notifications-banner">
            <div class="notifications-banner-content">
                <div class="notifications-banner-text">
                    <h1 class="notifications-banner-title">
                        <i class="bi bi-bell-fill"></i>
                        Известия
                    </h1>
                    <p class="notifications-banner-description">
                        @if (unreadCount > 0)
                        {
                            <text>Имате @unreadCount @(unreadCount == 1 ? "непрочетено известие" : "непрочетени известия")</text>
                        }
                        else
                        {
                            <text>Всички известия са прочетени</text>
                        }
                    </p>
                </div>
                @if (unreadCount > 0)
                {
                    <div class="notifications-banner-actions">
                        <button id="markAllAsRead" class="btn btn-mark-all-read-banner">
                            <i class="bi bi-check-all"></i>
                            <span>Маркирай всички като прочетени</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">
                <i class="bi bi-bell-fill me-2"></i>Известия
            </h1>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card notifications-card shadow-sm">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-list-ul"></i>
                        Всички известия
                    </h5>
                    @if (Model.Any(n => !n.IsRead))
                    {
                        <button id="markAllAsRead" class="btn btn-sm btn-primary d-none d-md-inline-flex">
                            <i class="bi bi-check-all me-2"></i>Маркирай всички като прочетени
                        </button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var notification in Model)
                            {
                                <div class="notification-item @(notification.IsRead ? "" : "unread")" data-id="@notification.Id">
                                    <div class="d-flex align-items-start">
                                        <div class="notification-icon">
                                            <i class="bi bi-info-circle-fill"></i>
                                        </div>
                                        <div class="notification-content">
                                            <p>@notification.Message</p>
                                            <small>@notification.DateSent.ToString("dd MMM yyyy, HH:mm")</small>
                                        </div>
                                        @if (!notification.IsRead)
                                        {
                                            <button class="btn btn-sm btn-outline-primary mark-read ms-auto" data-id="@notification.Id">
                                                <i class="bi bi-check"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="notifications-empty-state">
                            <i class="bi bi-bell-slash"></i>
                            <h5>Няма известия</h5>
                            <p>В момента нямате известия</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/notification-index.js" asp-append-version="true"></script>
} 