@model SecuritySystemsManagerMVC.ViewModels.LocationDetailsVm
@using SecuritySystemsManager.Shared.Enums

@{
    ViewData["Title"] = "Изтриване на локация";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="~/css/locations.css" />
}

<div class="card">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Изтриване на локация</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Предупреждение:</strong> Сигурни ли сте, че искате да изтриете тази локация? Това действие не може да бъде отменено.
        </div>
        
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="mb-3">
                    <h6 class="text-muted mb-1">Име</h6>
                    <p class="fs-5">@Model.Name</p>
                </div>
                <div class="mb-3">
                    <h6 class="text-muted mb-1">Адрес</h6>
                    <p>@Model.Address</p>
                </div>
                <div class="mb-3">
                    <h6 class="text-muted mb-1">Координати</h6>
                    <p>
                        <span class="badge bg-info me-2">Ширина: @Model.Latitude</span>
                        <span class="badge bg-info">Дължина: @Model.Longitude</span>
                    </p>
                </div>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="mb-3">
                        <h6 class="text-muted mb-1">Описание</h6>
                        <p>@Model.Description</p>
                    </div>
                }
            </div>
            
            <div class="col-md-6">
                <div id="deleteLocationMap" 
                     data-latitude="@Model.Latitude" 
                     data-longitude="@Model.Longitude"
                     data-name="@Model.Name"
                     data-address="@Model.Address"
                     data-description="@Model.Description"
                     style="height: 300px; width: 100%; border-radius: 8px;">
                </div>
            </div>
        </div>
        
        @if (Model.Orders != null && Model.Orders.Any())
        {
            <div class="alert alert-danger mb-4">
                <i class="bi bi-exclamation-circle me-2"></i>
                <strong>Предупреждение:</strong> Тази локация има @Model.Orders.Count свързани поръчки. Изтриването на тази локация може да засегне тези поръчки.
            </div>
            
            <div class="table-responsive mb-4">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID на поръчка</th>
                            <th>Статус</th>
                            <th>Дата</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td>#@order.Id</td>
                                <td>
                                    <span class="badge bg-@GetStatusBadgeClass(order.Status)">
                                        @GetStatusDisplayName(order.Status)
                                    </span>
                                </td>
                                <td>@order.CreatedAt.ToShortDateString()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-between">
                <a asp-action="List" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Обратно към списъка
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-2"></i>Изтрий
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/locations.js"></script>
    <script src="~/js/locations-delete.js"></script>
}

@functions {
    string GetStatusBadgeClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "warning",
            OrderStatus.InProgress => "primary",
            OrderStatus.Completed => "success",
            OrderStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }
    
    string GetStatusDisplayName(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.InProgress => "В процес",
            _ => status.ToString()
        };
    }
} 