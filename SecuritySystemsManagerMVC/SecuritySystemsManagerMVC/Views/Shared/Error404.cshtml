@{
    ViewData["Title"] = "Страницата не е намерена";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/error-pages.css" />
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="error-page">
                <div class="error-code">
                    <h1 class="display-1 text-muted">404</h1>
                </div>
                <div class="error-message">
                    <h2 class="mb-4">Страницата не е намерена</h2>
                    <p class="lead text-muted mb-4">
                        Страницата, която търсите, може да е премахната, да е променено името й 
                        или временно да не е достъпна.
                    </p>
                    <div class="error-actions">
                        <a href="/" class="btn btn-primary me-3">
                            <i class="bi bi-house me-2"></i>Към началото
                        </a>
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Назад
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 