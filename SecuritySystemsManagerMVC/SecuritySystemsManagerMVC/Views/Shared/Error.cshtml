@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}

<h1 class="text-danger">Грешка.</h1>
<h2 class="text-danger">Възникна грешка при обработката на заявката ви.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID на заявка:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Режим на разработка</h3>
<p>
    Превключването към среда <strong>Development</strong> ще покаже по-подробна информация за възникналата грешка.
</p>
<p>
    <strong>Средата за разработка не трябва да бъде активирана за внедрени приложения.</strong>
    Това може да доведе до показване на чувствителна информация от изключения на крайните потребители.
    За локално отстраняване на грешки активирайте средата <strong>Development</strong>, като зададете променливата на средата <strong>ASPNETCORE_ENVIRONMENT</strong> на <strong>Development</strong>
    и рестартирате приложението.
</p>
